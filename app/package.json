{
  "name": "chetyre-shtolni",
  "version": "1.0.0",
  "description": "Четыре Штольни: шутер с разрушаемой землёй",
  "author": "botirbekzulf-sudo",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "prepare-web": "node scripts/prepare.js",
    "android-project": "npx cap add android && node scripts/patch-android.js && npx cap sync android",
    "windows": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.botirbekzulf.chetyreshtolni",
    "productName": "Chetyre Shtolni",
    "directories": { "output": "dist" },
    "files": ["electron/**", "www/**", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
